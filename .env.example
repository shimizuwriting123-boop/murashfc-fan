# MVP投票（/api/mvp-vote, /api/mvp-results）で使う。
# いずれもサーバー側でのみ読む。ブラウザには渡らない（PUBLIC_ 接頭辞を付けないこと）。
#
# ローカル開発では、このファイルを .env にコピーして値を入れる。
# 本番は Vercel のプロジェクト設定 → Environment Variables に同じ3つを登録する。

# Supabase プロジェクトの URL（例: https://xxxxxxxx.supabase.co）
SUPABASE_URL=

# Service Role キー。RLS を貫通するため、絶対にブラウザ側へ出さない。
SUPABASE_SERVICE_ROLE_KEY=

# 投票者ハッシュ（sha256(IP + UA + ソルト)）に使うソルト。
# 十分に長いランダム文字列を設定する。例: openssl rand -hex 32
VOTE_HASH_SALT=
