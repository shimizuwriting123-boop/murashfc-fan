---
import "../styles/global.css";
// 見出し用の Oswald（--font-display）。未読み込みだと Arial Narrow 不在の端末
// （iOS 等）で太い標準 sans にフォールバックし、意図した縦長の見出しにならない。
// Oswald は 200〜700 のみで 900 は存在しないため font-black は使わない。
// 使用ウェイトのみ：400（既定）/ 600（font-semibold）/ 700（font-bold）
import "@fontsource/oswald/latin-400.css";
import "@fontsource/oswald/latin-600.css";
import "@fontsource/oswald/latin-700.css";
import "@fontsource/bebas-neue/latin-400.css";
import "@fontsource/noto-serif-jp/japanese-700.css";
import "@fontsource/shippori-mincho-b1/japanese-800.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** 記事個別のOGP画像（ルート相対パス）。未指定なら共通ヒーロー画像。 */
  ogImage?: string;
}

const {
  title = "ムラッシュFC ファンサイト（非公認）",
  description = "加藤純一がオーナーのキングスリーグ日本チーム「ムラッシュFC」を応援する非公認ファンサイト。選手名鑑・大会の軌跡・歴史・用語辞典・ブログをお届けします。",
  ogImage,
} = Astro.props;

// OGP画像は絶対URLで出力する（X等のクローラーは相対パスを解決できないため）。
// ドメインは astro.config の site 設定（Astro.site）を唯一の情報源とし、
// sitemap / canonical と一貫させる。site 未設定時のみ本番ドメインへフォールバック。
const OG_FALLBACK = "/images/hero-banner-og.jpg";
const siteOrigin = Astro.site ?? new URL("https://murashfc-fan.com");
const ogImageUrl = new URL(ogImage ?? OG_FALLBACK, siteOrigin).href;
// 共通ヒーロー画像は 1200×675、記事個別OGPは 1200×630（OGP標準）を想定。
const ogImageHeight = ogImage ? "630" : "675";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon-256.png" />
    <link rel="apple-touch-icon" href="/favicon-256.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@murashfcfan" />
    <meta name="twitter:creator" content="@murashfcfan" />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preload" as="image" type="image/webp" href="/images/hero-banner.webp" fetchpriority="high" />

    <title>{title}</title>

    {
      import.meta.env.PROD && (
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.addEventListener('load', function() {
            setTimeout(function() {
              var s = document.createElement('script');
              s.src = 'https://www.googletagmanager.com/gtag/js?id=G-HMFVVLCKCL';
              document.head.appendChild(s);
              gtag('js', new Date());
              gtag('config', 'G-HMFVVLCKCL');
            }, 2000);
          });
        `} />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
